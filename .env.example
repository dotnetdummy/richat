# Copy to .env in this directory. Do not commit the copy.
# Compose sets DATABASE_URL from POSTGRES_* below. Do not set DATABASE_URL
# yourself unless you are pointing the app at an external Postgres.

POSTGRES_USER=richat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=richat

# Host port mapped to the app container (1987 inside).
PORT=1987

# Public origin of this deployment (https in production).
APP_URL=http://localhost:1987
# Optional. Defaults to APP_URL. Comma-separated extra origins if needed.
# AUTH_TRUSTED_ORIGINS=https://chat.example.com

# Email, or Steam persona name, of the first operator. Only honored until a
# human admin exists. After that, manage users from Admin.
INITIAL_ADMIN=

# openssl rand -base64 32
# Keep the same secret in production. Rotating it invalidates every session.
# With email/password login it also breaks sign-in, because stored emails are
# HMAC'd with this value.
AUTH_SECRET=

# Login provider: configure exactly one of the three below, or the app
# refuses to start.

# 1) Steam OpenID login
STEAM_API_KEY=

# 2) Email/password login (no email infrastructure: admins reset lost
#    passwords from Admin -> Users; users change theirs in Settings -> Profile)
# AUTH_EMAIL_PASSWORD=true

# 3) Generic OAuth2 / OIDC login
# OAUTH2_CLIENT_ID=
# OAUTH2_CLIENT_SECRET=
# OAUTH2_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# Instead of the discovery URL you can set explicit endpoints:
# OAUTH2_AUTHORIZATION_URL=
# OAUTH2_TOKEN_URL=
# OAUTH2_USERINFO_URL=
# Optional. Default "openid,profile,email".
# OAUTH2_SCOPES=openid,profile,email
# Optional. Login button label. Default "OAuth".
# OAUTH2_PROVIDER_NAME=

# npx --yes web-push generate-vapid-keys
# Keep the same pair in production; rotating it invalidates every device's
# push subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional. KLIPY GIF search. Without this, only uploaded server GIFs are available.
# KLIPY_APP_KEY=

# Optional. Default 10.
# EMAIL_SALT_ROUNDS=10

# Optional. Unpinned messages not edited in this many days are deleted.
# Default 90. Replies to a still-pinned parent stay.
# MESSAGE_RETENTION_DAYS=90

# Optional. Pinned messages not edited in this many days are deleted.
# Default 365. Deleting a pin also deletes its thread replies.
# PINNED_MESSAGE_RETENTION_DAYS=365

# Optional. Accounts inactive this many days are deleted. Default 365. Set 0 to
# disable account deletion without changing message retention.
# USER_RETENTION_DAYS=365

# Optional. Voice TURN. See docs/turn.md.
# TURN_HOST=turn.example.com
# TURN_USERNAME=richat
# TURN_CREDENTIAL=

# Optional. Max people in a voice huddle. Default 8. Quality is best at 6 or
# fewer, especially with screen share or several cameras.
# MAX_VOICE_PARTICIPANTS=8

# Optional. Default true. Set false to skip migrations at boot.
# DB_MIGRATE_ON_START=true

# Optional. Pin a release instead of latest.
# RICHAT_IMAGE=dotnetdummy/richat:1.36.0
