# Copy to .env in this directory. Do not commit the copy.
# Used by docker compose for coturn. The Richat app needs matching
# TURN_HOST / TURN_USERNAME / TURN_CREDENTIAL (or ICE_SERVERS).

TURN_USER=richat
TURN_PASS=change-me
TURN_REALM=change-me.example.com

# Public IPv4 of the host that runs coturn. Required so relayed
# candidates advertise an address peers can actually reach.
TURN_EXTERNAL_IP=203.0.113.10
